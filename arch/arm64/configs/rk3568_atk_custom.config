# ===================== 系统基础与调试裁剪【量产核心：关闭全部调试，减小体积、防信息泄露、提升性能】 =====================
# CONFIG_DEBUG is not set
# 依据：关闭全局调试总开关，关闭大量debugfs、trace、pr_debug打印，量产不需要内核调试输出，减少CPU开销

# CONFIG_DEBUG_FS is not set
# 依据：debugfs调试文件系统，仅开发调试用；量产关闭，减少内存占用，防止用户读取内核调试节点泄露硬件信息

# CONFIG_KGDB is not set
# 依据：内核远程调试器，量产完全不需要，关闭避免调试接口被利用

# CONFIG_PROC_KCORE is not set
# 依据：/proc/kcore导出内核虚拟内存，安全风险，量产关闭

CONFIG_PRINTK=y
# 依据：保留printk，内核异常panic时能输出日志到串口，方便售后定位死机；不要关闭

CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
# 依据：默认日志级别4，只输出ERR/WARN，屏蔽大量INFO打印，避免串口刷屏拖慢系统

# CONFIG_DYNAMIC_DEBUG is not set
# 依据：动态调试打印，开发阶段用，量产关闭，缩减内核镜像大小

CONFIG_PANIC_ON_OOPS=y
# 依据：内核Oops时直接panic重启，量产设备需要自恢复，不要卡死挂住

CONFIG_PANIC_TIMEOUT=5
# 依据：panic后5秒自动重启，设备自动恢复，适合无人值守量产设备

# ===================== 内存管理 & IOMMU/DMA（RK3568 VOP显示依赖） =====================
CONFIG_DMA_CMA=y
# 依据：连续内存分配器；VOP、MIPI、HDMI显示驱动需要大块物理连续帧缓冲内存，必须开启

CONFIG_CMA_SIZE_MBYTES=64
# 依据：分配64M CMA；RK3568双屏显示+logo+图层，量产实测64M够用，不要盲目开大浪费内存

CONFIG_IOMMU_SUPPORT=y
# 依据：RK3568 VOP2内置IOMMU，显示硬件使用IOVA虚拟地址访问帧缓存，必须开启IOMMU子系统

CONFIG_ROCKCHIP_IOMMU=y
# 依据：瑞芯微平台IOMMU驱动，VOP2硬件MMU依赖，关闭后显示会直接花屏崩溃

# CONFIG_IOMMU_DEBUG is not set
# 依据：IOMMU调试，量产关闭

# ===================== CPU & 平台基础 RK3568 SoC =====================
CONFIG_ARCH_ROCKCHIP=y
# 依据：瑞芯微平台总开关，RK3568必选

CONFIG_PLATFORM_ROCKCHIP=y
# 依据：RK平台设备、时钟、电源域框架

CONFIG_CPUFREQ=y
# 依据：CPU调频，温控、功耗管理，量产必须，防止过热

CONFIG_ROCKCHIP_CPUFREQ=y
# 依据：RK平台CPU频率驱动

CONFIG_CPU_IDLE=y
# 依据：CPU idle休眠，降低待机功耗，量产设备必开

CONFIG_PM=y
# 依据：电源管理子系统，休眠、runtime‑pm，外设电源域开关（MIPI、VOP、HDMI电源）

CONFIG_PM_RUNTIME=y
# 依据：运行时电源管理；不用外设自动掉电，降低整机功耗

# CONFIG_PM_DEBUG is not set
# 依据：电源调试，量产关闭

CONFIG_ROCKCHIP_PM_DOMAINS=y
# 依据：RK电源域驱动，MIPI、VOP、HDMI、GPU等模块电源开关依赖

# ===================== 显示子系统 DRM（RK3568 核心业务） =====================
CONFIG_DRM=y
# 依据：Linux标准DRM显示子系统，RK显示全部基于DRM框架

CONFIG_DRM_ROCKCHIP=y
# 依据：Rockchip DRM驱动，VOP控制器核心驱动

CONFIG_DRM_ROCKCHIP_VOP2=y
# 依据：RK3568是VOP2硬件，必须开启

CONFIG_DRM_ROCKCHIP_MIPI_DSI=y
# 依据：MIPI‑DSI驱动，驱动DSI0/DSI1，接MIPI屏使用；如果产品不用MIPI屏可以关闭

CONFIG_DRM_ROCKCHIP_HDMI=y
# 依据：HDMI2.0驱动；产品不用HDMI则关闭，节约内核size

CONFIG_DRM_PANEL=y
# 依据：DRM panel框架，驱动树里panel节点解析

# CONFIG_DRM_FBDEV_EMULATION=y
# 依据：fbdev兼容层；很多应用依赖/dev/fb0；如果全部使用DRM原生APP可以关闭，量产建议保留兼容老应用

# CONFIG_DRM_DEBUG_MM is not set
# CONFIG_DRM_DP_AUX_CHARDEV is not set
# 依据：DRM调试节点，量产关闭

# CONFIG_FRAMEBUFFER_CONSOLE_DEBUG is not set
# 依据：fb console调试关闭

# ===================== 存储介质：eMMC / NAND / SD =====================
CONFIG_MMC=y
# 依据：MMC子系统，eMMC、SD卡依赖

CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
# 依据：RK DW MMC控制器驱动，RK3568 eMMC、SD控制器

CONFIG_MMC_BLOCK=y
# 依据：MMC块设备，eMMC作为存储盘

CONFIG_MMC_SDHCI=y
# 依据：SD卡支持

CONFIG_MTD=y
# 依据：MTD子系统，SPI‑NAND、Raw NAND使用；产品只用eMMC可以关闭MTD整套

CONFIG_MTD_SPI_NAND=y
# 依据：SPI NAND Flash驱动，如果硬件没有SPI NAND就关闭

CONFIG_MTD_NAND_ROCKCHIP=y
# 依据：RK raw‑nand控制器；不用并行NAND就关闭

CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=2
# 依据：ramdisk，只保留少量，initramfs启动需要；不要开多，占用内存

# ===================== 文件系统【量产只保留业务必需，裁剪大量小众fs】 =====================
CONFIG_TMPFS=y
# 依据：tmpfs，/tmp /run 内存文件系统，系统运行必需，不可删除

CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
# 依据：只读压缩文件系统，量产固件常用squashfs根文件系统；如果用ext4根fs，可关闭squashfs

CONFIG_EXT4_FS=y
# 依据：ext4，eMMC分区文件系统，量产最常用

# CONFIG_EXT4_DEBUG is not set
# 依据：ext4调试关闭

# --------------- 大量无用文件系统全部关闭 ---------------
CONFIG_FAT_FS=n
# 依据：如果不需要U盘FAT，关闭；需要U盘则打开CONFIG_FAT_FS、CONFIG_MSDOS_PARTITION
# CONFIG_BTRFS is not set
# CONFIG_XFS is not set
# CONFIG_JFS_FS is not set
# CONFIG_REISERFS_FS is not set
# CONFIG_NTFS3_FS is not set
# 依据：量产不需要btrfs/xfs/ntfs等，裁剪减小内核体积

CONFIG_PARTITION_MSDOS=y
CONFIG_PARTITION_EFI=y
# 依据：支持MBR/GPT分区表，eMMC分区识别必需

# ===================== 网络部分：以太网，裁剪无用网络协议 =====================
CONFIG_NET=y
# 依据：网络子系统总开关；设备完全无网可以关闭，大部分量产设备保留

CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_DWMAC_ROCKCHIP=y
# 依据：RK3568 GMAC以太网控制器，YT8531C等PHY使用

CONFIG_PHYLIB=y
# 依据：PHY子系统，以太网PHY驱动必需

# CONFIG_WLAN is not set
# 依据：无WiFi模块就关闭整套WLAN，减小内核；有WiFi模组再打开

# --------------- 裁剪不使用网络协议 ---------------
# CONFIG_ATM is not set
# CONFIG_BRIDGE is not set
# CONFIG_NETFILTER is not set
# 依据：不需要防火墙/网桥就关闭netfilter，大幅裁剪；产品需要iptables则保留

CONFIG_INET=y
# 依据：TCP/IP v4，绝大多数设备必选

# CONFIG_IPV6 is not set
# 依据：产品业务不使用IPv6，直接关闭，节约内存；业务要IPv6则=y

CONFIG_UNIX=y
# 依据：Unix域套接字，本地进程间通信，用户态systemd/app必选，不能关闭

# ===================== 外设驱动 I2C SPI UART GPIO =====================
CONFIG_I2C=y
CONFIG_I2C_DW=y
CONFIG_I2C_ROCKCHIP=y
# 依据：RK I2C控制器；TP、触控、HDMI EDID、电源芯片大量外设依赖，保留

CONFIG_SPI=y
CONFIG_SPI_DW=y
CONFIG_SPI_ROCKCHIP=y
# 依据：SPI控制器；SPI‑NAND、SPI屏使用，硬件不用SPI可以关闭

CONFIG_SERIAL=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_CONSOLE=y
# 依据：UART串口；console调试串口，产品业务串口；量产建议保留console方便售后调试

CONFIG_GPIOLIB=y
CONFIG_GPIO_ROCKCHIP=y
# 依据：RK GPIO驱动，控制复位、背光、电源使能脚，必选

CONFIG_BACKLIGHT_CLASS=y
CONFIG_BACKLIGHT_PWM=y
# 依据：PWM背光驱动，MIPI屏幕背光调节，显示产品必须

CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
# 依据：RK PWM控制器，背光、蜂鸣器使用

# ===================== 无用子系统裁剪 =====================
# CONFIG_SOUND is not set
# 依据：产品不需要音频则关闭ALSA声音子系统；有音频业务开启CONFIG_SOUND CONFIG_SND_ROCKCHIP

# CONFIG_USB_SUPPORT=y
# 依据：有USB外设就打开；完全不用USB则关闭整套USB子系统节省size
# CONFIG_USB_XHCI_HCD=y
# CONFIG_USB_DWC3=y
# CONFIG_USB_DWC3_ROCKCHIP=y
# 依据：RK3568 XHCI USB3.0控制器；无USB外设注释掉

# CONFIG_LEGACY_PTYS is not set
# 依据：老式pty，不需要可以关闭

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# 依据：devtmpfs，/dev自动创建设备节点，嵌入式Linux必须，不可关闭

# CONFIG_SYSFS_DEPRECATED is not set
# 依据：废弃sysfs兼容，关闭

# ===================== 安全与量产加固 =====================
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=n
# 依据：apparmor复杂安全框架，嵌入式量产一般不用，关闭

CONFIG_DEFAULT_SECURITY_DAC=y
# 依据：传统Unix权限DAC，够用

# CONFIG_KEXEC is not set
# 依据：kexec热重启内核，量产设备不需要

# CONFIG_CRASH_DUMP is not set
# 依据：内核崩溃转储，开发调试用，量产关闭，dump会占用大块内存

CONFIG_RANDOM_TRUST_CPU=y
# 依据：信任硬件随机数，快速获得/dev/random熵，嵌入式启动加快

# ===================== 内核压缩与镜像 =====================
CONFIG_KERNEL_GZIP=y
# 依据：内核镜像gzip压缩；也可以选LZ4解压更快，适合RK启动
# CONFIG_KERNEL_LZ4=y
