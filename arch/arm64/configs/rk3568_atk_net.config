CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y

CONFIG_NETDEVICES=y             # drivers/net/
CONFIG_ETHERNET=y               # drivers/net/ethernet
CONFIG_NET_VENDOR_STMICRO=y     # drivers/net/ethernet/stmicro
CONFIG_STMMAC_ETH=y             # drivers/net/ethernet/stmicro/stmmac（会 select PHYLINK/MII/PCS_XPCS）.启用配置后, 会带动一系列STMMAC的配置
CONFIG_PHYLINK=y
CONFIG_PHYLIB=y                # 在只有这个驱动的情况, 看看能否行得通

CONFIG_PTP_1588_CLOCK=y

# ------- 设备树, 调试文件 --------
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_OF=y
# /sys/kernel/debug/
CONFIG_DEBUG_FS=y


# -------- NFS ----------
CONFIG_NFS_FS=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=y
CONFIG_NFS_SWAP=y

#
# -------- D-PHY, MIPI CSI, I2C, Video, V4L2, Media ----------
#
CONFIG_MEDIA_SUPPORT=y                       # 功能: 多媒体子系统总开关; 目录: drivers/media/; 源文件: media_devnode.c, media-device.c...
CONFIG_MEDIA_CAMERA_SUPPORT=y                # 功能: 摄像头类抓拍/录像支持; 目录: drivers/media/; 源文件: v4l2-dev.c...
CONFIG_MEDIA_PLATFORM_SUPPORT=y              # 功能: vidoebuf2, VIDEO_ROCKCHIP_CIF=y, VIDEO_ROCKCHIP_ISP=y
CONFIG_VIDEO_DEV=y                           # 功能: V4L2 核心字符设备; 目录: drivers/media/v4l2-core/; 源文件: v4l2-dev.c, videodev2...
CONFIG_MEDIA_CONTROLLER=y                    # 功能: Media Controller 管线拓扑; 目录: drivers/media/mc/; 源文件: mc-device.c, media-device.c
CONFIG_VIDEO_V4L2=y                          # 功能: V4L2 核心; 目录: drivers/media/v4l2-core/; 源文件: v4l2-ioctl.c...
CONFIG_VIDEO_V4L2_I2C=y                      # 功能: V4L2 I2C 子设备辅助; 目录: drivers/media/v4l2-core/; 源文件: v4l2-i2c.c
CONFIG_VIDEO_V4L2_SUBDEV_API=y               # 功能: 子设备 API(管线互联必需); 目录: drivers/media/v4l2-core/; 源文件: v4l2-subdev.c
CONFIG_V4L2_FWNODE=y                         # 功能: 解析 DT fwnode 端点/管线; 目录: drivers/media/v4l2-core/; 源文件: v4l2-fwnode.c
CONFIG_VIDEOBUF2_CORE=y                      # 功能: videobuf2 缓冲核心; 目录: drivers/media/common/videobuf2/; 源文件: videobuf2-core.c
CONFIG_VIDEOBUF2_V4L2=y                      # 功能: videobuf2 V4L2 适配层; 目录: drivers/media/common/videobuf2/; 源文件: videobuf2-v4l2.c
CONFIG_VIDEOBUF2_MEMOPS=y                    # 功能: videobuf2 内存操作; 目录: drivers/media/common/videobuf2/; 源文件: videobuf2-memops.c
CONFIG_VIDEOBUF2_CMA_SG=y                    # 功能: videobuf2 CMA scatter-gather(ISP/VICAP采集必需); 目录: drivers/media/common/videobuf2/; 源文件: videobuf2-cma-sg.c
CONFIG_VIDEOBUF2_DMA_CONTIG=y                # 功能: videobuf2 DMA 连续内存; 目录: drivers/media/common/videobuf2/; 源文件: videobuf2-dma-contig.c
CONFIG_VIDEOBUF2_VMALLOC=y                   # 功能: videobuf2 vmalloc 内存; 目录: drivers/media/common/videobuf2/; 源文件: videobuf2-vmalloc.c
CONFIG_VIDEOBUF2_DMA_SG=y                    # 功能: videobuf2 DMA scatter-gather; 目录: drivers/media/common/videobuf2/; 源文件: videobuf2-dma-sg.c

CONFIG_V4L_PLATFORM_DRIVERS=y                # 功能: rockchip平台的video相关的硬件IP
CONFIG_V4L_MEM2MEM_DRIVERS=y


# ── 传感器 Sony IMX415 ────────────────────────────────────────────────
CONFIG_VIDEO_IMX415=y                        # 功能: IMX415 4-lane 抓拍/录像传感器驱动; 目录: drivers/media/i2c/; 源文件: imx415.c

# ── MIPI D-PHY (RK3568 CSI2 D-PHY) ────────────────────────────────────
CONFIG_PHY_ROCKCHIP_CSI2_DPHY=y              # 功能: RK3568 MIPI CSI2 D-PHY(compatible rk3568-csi2-dphy[-hw]); 目录: drivers/phy/rockchip/; 源文件: phy-rockchip-csi2-dphy.c, phy-rockchip-csi2-dphy-hw.c
CONFIG_GENERIC_PHY=y                       # 功能: 通用 PHY 框架(被 select); 目录: drivers/phy/; 源文件: phy-core.c
CONFIG_GENERIC_PHY_MIPI_DPHY=y             # 功能: MIPI D-PHY 通用接口; 目录: drivers/phy/; 源文件: phy-core-mipi-dphy.c
CONFIG_PHY_ROCKCHIP_MIPI_RX=y                # 功能: Rockchip MIPI RX D-PHY(其他 SoC, 一并编译); 目录: drivers/phy/rockchip/; 源文件: phy-rockchip-mipi-rx.c

# ── MIPI CSI-2 Host + VICAP ───────────────────────────────────────────
CONFIG_VIDEO_ROCKCHIP_CIF=y                  # 功能: VICAP(rkcif) + MIPI CSI2 Host; 目录: drivers/media/platform/rockchip/cif/; 源文件: dev.c, capture.c, mipi-csi2.c, hw.c, common.c, subdev-itf.c, cif-luma.c, cif-scale.c, cif-tools.c, cif-rockit.c, procfs.c
CONFIG_ROCKCHIP_CIF_WORKMODE_PINGPONG=y    # 功能: VICAP 乒乓工作模式; 目录: drivers/media/platform/rockchip/cif/; 源文件: (编译期宏)
CONFIG_ROCKCHIP_CIF_USE_DUMMY_BUF=y        # 功能: VICAP 使用 dummy 缓冲; 目录: drivers/media/platform/rockchip/cif/; 源文件: (编译期宏)

# ── ISP (ISP V21 for RK3568) ──────────────────────────────────────────
CONFIG_VIDEO_ROCKCHIP_ISP=y                  # 功能: Rockchip ISP 主驱动; 目录: drivers/media/platform/rockchip/isp/; 源文件: rkisp.c, dev.c, hw.c, capture.c, csi.c, isp_params.c, isp_stats.c, dmarx.c, common.c, regs.c, procfs.c
CONFIG_VIDEO_ROCKCHIP_ISP_VERSION_V21=y    # 功能: RK3568 使用 ISP V21 硬件版本; 目录: drivers/media/platform/rockchip/isp/; 源文件: capture_v21.c, isp_params_v21.c, isp_stats_v21.c

# ── ISPP (后处理, 可选) ───────────────────────────────────────────────
CONFIG_VIDEO_ROCKCHIP_ISPP=y                 # 功能: ISP 后处理单元; 目录: drivers/media/platform/rockchip/ispp/; 源文件: ispp.c, dev.c, hw.c, common.c, params.c, stats.c, stream.c, procfs.c, fec.c

# ── RGA (2D 图形加速) ─────────────────────────────────────────────────
CONFIG_ROCKCHIP_MULTI_RGA=y                  # 功能: multi-RGA(rga3) 主驱动, 接管 rockchip,rga2; 目录: drivers/video/rockchip/rga3/; 源文件: rga_drv.c, rga_job.c, rga_mm.c, rga_hw_config.c, rga_common.c, rga_iommu.c, rga_dma_buf.c, rga_fence.c, rga_policy.c, rga_debugger.c, rga2_reg_info.c, rga3_reg_info.c
CONFIG_ROCKCHIP_RGA_ASYNC=y                # 功能: RGA 异步(fence)提交; 目录: drivers/video/rockchip/rga3/; 源文件: rga_fence.c
CONFIG_ROCKCHIP_RGA_DEBUG_FS=y             # 功能: RGA debugfs 调试; 目录: drivers/video/rockchip/rga3/; 源文件: rga_debugger.c
CONFIG_ROCKCHIP_RGA_DEBUGGER=y             # 功能: RGA 调试器(被 select); 目录: drivers/video/rockchip/rga3/; 源文件: rga_debugger.c
CONFIG_VIDEO_ROCKCHIP_RGA=y                  # 功能: V4L2 RGA 驱动(rk3288/rk3399, 本板未绑定); 目录: drivers/media/platform/rockchip/rga/; 源文件: rga.c, rga-hw.c, rga-buf.c

# ── 支撑子系统 ────────────────────────────────────────────────────────
CONFIG_I2C=y                                 # 功能: I2C 总线(IMX415 挂在 i2c4/0x1a); 目录: drivers/i2c/; 源文件: i2c-core*.c
CONFIG_IOMMU_SUPPORT=y                       # 功能: IOMMU 框架(采集 DMA 地址映射); 目录: drivers/iommu/; 源文件: iommu.c
CONFIG_ROCKCHIP_IOMMU=y                      # 功能: Rockchip IOMMU(rkcif_mmu/rkisp_mmu); 目录: drivers/iommu/; 源文件: rockchip-iommu.c
CONFIG_DMA_CMA=y                             # 功能: 连续内存分配(帧缓冲); 目录: mm/; 源文件: cma.c, dma-contiguous.c
CONFIG_CMA=y                                 # 功能: CMA 分配器; 目录: mm/; 源文件: cma.c
CONFIG_CMA_SIZE_MBYTES=16                    # 功能: CMA 预留大小
CONFIG_OF=y                                  # 功能: 设备树支持(解析 CSI/VICAP/ISP/RGA 节点); 目录: drivers/of/; 源文件: base.c...
CONFIG_ROCKCHIP_PM_DOMAINS=y                 # 功能: RK 电源域(RK3568_PD_VI / RK3568_PD_RGA); 目录: drivers/soc/rockchip/; 源文件: pm_domains.c
CONFIG_ROCKCHIP_GRF=y                        # 功能: GRF 寄存器访问(CSI2/ISP 需 rockchip,grf); 目录: drivers/soc/rockchip/; 源文件: grf.c

# —— GPIO ——
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_GENERIC_PLATFORM=y
CONFIG_POWER_RESET_GPIO=y
CONFIG_POWER_RESET_GPIO_RESTART=y

# -------- PTY ----------
# CONFIG_LEGACY_PTYS=n
CONFIG_LEGACY_PTY_COUNT=0

